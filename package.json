{
  "name": "terum-memory",
  "version": "0.1.0",
  "description": "Local-first memory + decision record for individual developers working with coding agents. One SQLite file, no server, no accounts.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanliu-terum/terum-memory.git"
  },
  "homepage": "https://github.com/ryanliu-terum/terum-memory#readme",
  "bugs": {
    "url": "https://github.com/ryanliu-terum/terum-memory/issues"
  },
  "author": "Terum",
  "keywords": [
    "memory",
    "decision-record",
    "coding-agents",
    "claude-code",
    "mcp",
    "local-first",
    "sqlite",
    "embeddings",
    "knowledge-base",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "terum-memory": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/db/schema.sql dist/db/schema.sql",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.11.1",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
